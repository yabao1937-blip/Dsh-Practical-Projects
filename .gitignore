# Python
__pycache__/
*.pyc
.venv/
*.db

# 前端 / 构建
node_modules/
dist/

# IDE / 缓存
.idea/
.pytest_cache/

# 运行时数据库（含 SQLite WAL 的伴生文件）
backend/data/*.db
*.db-wal
*.db-shm
*.db-journal

# 临时 / 检查输出
backend/inspect_out*.txt

# Office 打开文档时的临时锁文件
~$*

# 写接口 token（每台机器自动生成，不入库）
backend/data/write_token.txt

# force 覆盖前的自动备份（就地回滚用，不入库）
backend/data/backups/
